# Adobe Fonts kit ID that includes Aquavit (leave empty to use the fallback serif)
NEXT_PUBLIC_ADOBE_KIT_ID=
# Public site URL for metadata, sitemap and robots
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# WhatsApp number in international format, digits only (defaults to 201016895099)
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Clinic phone numbers, separated by "|" or "," (defaults to +20 101 689 5099 | +20 109 207 9155)
NEXT_PUBLIC_PHONE=
# Contact email; used as the form fallback when WhatsApp is not set
NEXT_PUBLIC_CONTACT_EMAIL=
# Opening hours, one line per language (e.g. "Saturday to Thursday, 10:00 to 20:00")
NEXT_PUBLIC_HOURS_AR=
NEXT_PUBLIC_HOURS_EN=
# Google Maps embed URL for the contact page iframe
NEXT_PUBLIC_MAP_EMBED_URL=
# Social profile URLs
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_TIKTOK_URL=
# Set to false at launch to hide every page whose service or claim is not yet confirmed
NEXT_PUBLIC_SHOW_UNVERIFIED=true
